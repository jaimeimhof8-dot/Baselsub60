[
  {
    "name": "Training abhaken (Erledigt)",
    "note": "Heute «Erledigt», Dialog «Einheit abschliessen», Speichern: alle Übungen von heute sind abgehakt.",
    "start": {
      "seed": "voll",
      "date": "2026-10-27"
    },
    "steps": [
      {
        "type": "click",
        "sel": "[data-act=\"all-done\"]",
        "text": "Erledigt",
        "expect": [
          {
            "kind": "sel",
            "sel": "[data-fin=\"save\"]",
            "present": true
          },
          {
            "kind": "prefixcount",
            "path": "done",
            "prefix": "2026-10-27|",
            "max": 0
          }
        ]
      },
      {
        "type": "click",
        "sel": "[data-fin=\"save\"]",
        "text": "Speichern",
        "expect": [
          {
            "kind": "prefixcount",
            "path": "done",
            "prefix": "2026-10-27|",
            "min": 3
          },
          {
            "kind": "sel",
            "sel": "[data-fin=\"save\"]",
            "present": false
          }
        ]
      }
    ]
  },
  {
    "name": "Fokusmodus: Übung erledigen und beenden",
    "note": "Start, erste Übung «Fertig», Beenden: Zustand bleibt gespeichert, Fokusansicht verschwindet.",
    "start": {
      "seed": "voll",
      "date": "2026-10-27"
    },
    "steps": [
      {
        "type": "click",
        "sel": "[data-fc=\"start\"]",
        "text": "Fokusmodus starten",
        "expect": [
          {
            "kind": "sel",
            "sel": "#focus",
            "present": true
          },
          {
            "kind": "prefixcount",
            "path": "done",
            "prefix": "2026-10-27|",
            "max": 0
          }
        ]
      },
      {
        "type": "click",
        "sel": "[data-fc=\"sdone\"]",
        "text": "Fertig",
        "expect": [
          {
            "kind": "state",
            "path": "done/2026-10-27|0",
            "op": "eq",
            "value": 1
          }
        ]
      },
      {
        "type": "click",
        "sel": "[data-fc=\"close\"]",
        "expect": [
          {
            "kind": "sel",
            "sel": "#focus",
            "present": false
          },
          {
            "kind": "state",
            "path": "done/2026-10-27|0",
            "op": "eq",
            "value": 1
          }
        ]
      }
    ]
  },
